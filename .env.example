# === LLM Configuration ===
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# === LLM Provider Examples (uncomment one and update API key) ===
# DeepSeek
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

#LLM_API_KEY=sk-xxx
#LLM_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
#LLM_MODEL=qwen3.6-plus

# Kimi (Moonshot)
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_MODEL=moonshot-v1-8k

# GLM (Zhipu AI)
# LLM_API_KEY=xxx
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4

# OpenAI
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# Qwen (DashScope / Alibaba Cloud)
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# SiliconFlow
# LLM_API_KEY=sk-xxx
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# === ASR Configuration ===
# funasr (recommended for Chinese) or whisper
ASR_ENGINE=funasr
# fast (base model) or accurate (large-v3 model)
ASR_MODE=fast

# === Output ===
OUTPUT_DIR=./output
# auto, zh, en
DEFAULT_LANGUAGE=auto

# === Network ===
HTTP_PROXY=

# === Douyin Cookies (for API direct mode) ===
DOUYIN_COOKIE_TTWID=
DOUYIN_COOKIE_ODIN_TT=
DOUYIN_COOKIE_CSRF_TOKEN=
DOUYIN_COOKIE_SESSIONID=
